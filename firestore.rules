rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validation Helpers
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'dealershipName', 'lastActive'])
        && data.uid is string && data.uid.size() <= 128
        && data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 100
        && data.dealershipName is string && data.dealershipName.size() > 0 && data.dealershipName.size() <= 120
        && data.lastActive is number
        && (!('email' in data) || (data.email is string && data.email.size() <= 256))
        && (!('avatarUrl' in data) || (data.avatarUrl is string && data.avatarUrl.size() <= 500))
        && (!('netWorth' in data) || data.netWorth is number)
        && (!('reputation' in data) || data.reputation is number)
        && (!('createdAt' in data) || data.createdAt is number);
    }

    function isValidSaveSlot(data) {
      return data.keys().hasAll(['id', 'userId', 'slotNumber', 'gameState', 'updatedAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.slotNumber is number && data.slotNumber >= 1 && data.slotNumber <= 10
        && data.gameState is string && data.gameState.size() <= 500000
        && data.updatedAt is number
        && (!('dealershipName' in data) || (data.dealershipName is string && data.dealershipName.size() <= 120))
        && (!('cash' in data) || data.cash is number)
        && (!('netWorth' in data) || data.netWorth is number)
        && (!('reputation' in data) || data.reputation is number)
        && (!('carsOwned' in data) || data.carsOwned is number)
        && (!('connectionsCount' in data) || data.connectionsCount is number);
    }

    function isValidB2BOffer(data) {
      return data.keys().hasAll(['id', 'sellerId', 'sellerName', 'carTitle', 'askingPrice', 'carData', 'status', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.sellerId is string && data.sellerId.size() <= 128
        && data.sellerName is string && data.sellerName.size() <= 100
        && data.carTitle is string && data.carTitle.size() <= 150
        && data.askingPrice is number && data.askingPrice >= 0
        && data.carData is string && data.carData.size() <= 50000
        && data.status is string && (data.status == 'active' || data.status == 'sold' || data.status == 'cancelled')
        && data.createdAt is number
        && (!('sellerDealership' in data) || (data.sellerDealership is string && data.sellerDealership.size() <= 120))
        && (!('make' in data) || (data.make is string && data.make.size() <= 80))
        && (!('model' in data) || (data.model is string && data.model.size() <= 80))
        && (!('year' in data) || data.year is number)
        && (!('mileage' in data) || data.mileage is number)
        && (!('condition' in data) || data.condition is number)
        && (!('buyerId' in data) || (data.buyerId is string && data.buyerId.size() <= 128))
        && (!('updatedAt' in data) || data.updatedAt is number);
    }

    function isValidLiveChat(data) {
      return data.keys().hasAll(['id', 'senderId', 'senderName', 'message', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.senderId is string && data.senderId.size() <= 128
        && data.senderName is string && data.senderName.size() <= 100
        && data.message is string && data.message.size() > 0 && data.message.size() <= 500
        && data.createdAt is number
        && (!('dealershipName' in data) || (data.dealershipName is string && data.dealershipName.size() <= 120));
    }

    function isValidPurchase(data) {
      return data.keys().hasAll(['id', 'userId', 'userName', 'packId', 'packTitle', 'amountUSD', 'status', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.userId is string && data.userId.size() <= 128
        && data.userName is string && data.userName.size() <= 100
        && data.packId is string && data.packId.size() <= 100
        && data.packTitle is string && data.packTitle.size() <= 150
        && data.amountUSD is number
        && data.status is string && (data.status == 'completed' || data.status == 'refunded')
        && data.createdAt is number
        && (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 256))
        && (!('dealershipName' in data) || (data.dealershipName is string && data.dealershipName.size() <= 120))
        && (!('rewardDetails' in data) || (data.rewardDetails is string && data.rewardDetails.size() <= 300))
        && (!('billingName' in data) || (data.billingName is string && data.billingName.size() <= 100))
        && (!('billingAddress' in data) || (data.billingAddress is string && data.billingAddress.size() <= 200))
        && (!('paymentMethodType' in data) || (data.paymentMethodType is string && data.paymentMethodType.size() <= 50));
    }

    function isValidAuctionBid(data) {
      return data.keys().hasAll(['id', 'auctionId', 'bidderId', 'bidderName', 'bidAmount', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.auctionId is string && data.auctionId.size() <= 128
        && data.bidderId is string && data.bidderId.size() <= 128
        && data.bidderName is string && data.bidderName.size() <= 100
        && data.bidAmount is number && data.bidAmount > 0
        && data.createdAt is number
        && (!('dealershipName' in data) || (data.dealershipName is string && data.dealershipName.size() <= 120))
        && (!('isAi' in data) || data.isAi is bool);
    }

    function isValidAuctionVote(data) {
      return data.keys().hasAll(['id', 'voterId', 'voterName', 'voteAllowAi', 'day', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.voterId is string && data.voterId.size() <= 128
        && data.voterName is string && data.voterName.size() <= 100
        && data.voteAllowAi is bool
        && data.day is number
        && data.createdAt is number;
    }

    function isValidRaceInvite(data) {
      return data.keys().hasAll(['id', 'senderId', 'senderName', 'targetUserId', 'trackId', 'trackName', 'raceType', 'stakeType', 'status', 'createdAt'])
        && data.id is string && data.id.size() <= 128
        && data.senderId is string && data.senderId.size() <= 128
        && data.senderName is string && data.senderName.size() <= 100
        && data.targetUserId is string && data.targetUserId.size() <= 128
        && data.trackId is string && data.trackId.size() <= 100
        && data.trackName is string && data.trackName.size() <= 150
        && data.raceType is string && (data.raceType == 'drag' || data.raceType == 'circuit' || data.raceType == 'sprint')
        && data.stakeType is string && (data.stakeType == 'friendly' || data.stakeType == 'cash' || data.stakeType == 'pink_slip')
        && data.status is string && (data.status == 'pending' || data.status == 'accepted' || data.status == 'declined' || data.status == 'completed' || data.status == 'cancelled')
        && data.createdAt is number;
    }

    // Match Collection Rules
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUser(incoming());
      allow delete: if false;
    }

    match /save_slots/{slotId} {
      allow get, list: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(slotId) && incoming().userId == request.auth.uid && isValidSaveSlot(incoming());
      allow update: if isSignedIn() && isValidId(slotId) && existing().userId == request.auth.uid && incoming().userId == request.auth.uid && isValidSaveSlot(incoming());
      allow delete: if isSignedIn() && isValidId(slotId) && existing().userId == request.auth.uid;
    }

    match /b2b_offers/{offerId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(offerId) && incoming().sellerId == request.auth.uid && isValidB2BOffer(incoming());
      allow update: if isSignedIn() && isValidId(offerId) && isValidB2BOffer(incoming()) && (
        (existing().sellerId == request.auth.uid && incoming().sellerId == request.auth.uid) ||
        (existing().status == 'active' && incoming().status == 'sold' && incoming().buyerId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'buyerId', 'updatedAt']))
      );
      allow delete: if isSignedIn() && isValidId(offerId) && existing().sellerId == request.auth.uid;
    }

    match /chat_messages/{messageId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(messageId) && incoming().senderId == request.auth.uid && isValidLiveChat(incoming());
      allow update, delete: if false;
    }

    match /purchases/{purchaseId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(purchaseId) && incoming().userId == request.auth.uid && isValidPurchase(incoming());
      allow update, delete: if false;
    }

    match /auction_bids/{bidId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(bidId) && incoming().bidderId == request.auth.uid && isValidAuctionBid(incoming());
      allow update, delete: if false;
    }

    match /auction_votes/{voteId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(voteId) && incoming().voterId == request.auth.uid && isValidAuctionVote(incoming());
      allow update, delete: if false;
    }

    match /race_invites/{inviteId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(inviteId) && incoming().senderId == request.auth.uid && isValidRaceInvite(incoming());
      allow update: if isSignedIn() && isValidId(inviteId) && isValidRaceInvite(incoming()) && (
        existing().senderId == request.auth.uid ||
        existing().targetUserId == request.auth.uid ||
        existing().targetUserId == 'open_lobby'
      );
      allow delete: if isSignedIn() && isValidId(inviteId) && existing().senderId == request.auth.uid;
    }
  }
}

