{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Public profile and account stats for an online dealer",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "displayName": { "type": "string", "maxLength": 100 },
        "dealershipName": { "type": "string", "maxLength": 120 },
        "avatarUrl": { "type": "string", "maxLength": 500 },
        "netWorth": { "type": "number" },
        "reputation": { "type": "number" },
        "lastActive": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "displayName", "dealershipName", "lastActive"]
    },
    "SaveSlot": {
      "title": "Save Slot",
      "description": "Cloud save state for a user slot",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "slotNumber": { "type": "number" },
        "dealershipName": { "type": "string", "maxLength": 120 },
        "cash": { "type": "number" },
        "netWorth": { "type": "number" },
        "reputation": { "type": "number" },
        "carsOwned": { "type": "number" },
        "connectionsCount": { "type": "number" },
        "gameState": { "type": "string", "maxLength": 500000 },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "userId", "slotNumber", "gameState", "updatedAt"]
    },
    "B2BOffer": {
      "title": "B2B Trade Offer",
      "description": "Multiplayer wholesale car listing on the live B2B network",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "sellerId": { "type": "string", "maxLength": 128 },
        "sellerName": { "type": "string", "maxLength": 100 },
        "sellerDealership": { "type": "string", "maxLength": 120 },
        "carTitle": { "type": "string", "maxLength": 150 },
        "make": { "type": "string", "maxLength": 80 },
        "model": { "type": "string", "maxLength": 80 },
        "year": { "type": "number" },
        "mileage": { "type": "number" },
        "condition": { "type": "number" },
        "askingPrice": { "type": "number" },
        "carData": { "type": "string", "maxLength": 50000 },
        "status": { "type": "string", "enum": ["active", "sold", "cancelled"] },
        "buyerId": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "sellerId", "sellerName", "carTitle", "askingPrice", "carData", "status", "createdAt"]
    },
    "LiveChat": {
      "title": "Live Chat Message",
      "description": "Community global chat message between live dealers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "dealershipName": { "type": "string", "maxLength": 120 },
        "message": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "senderId", "senderName", "message", "createdAt"]
    },
    "Purchase": {
      "title": "Microtransaction Purchase",
      "description": "Record of in-game purchases and capital boosts saved to Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userEmail": { "type": "string", "maxLength": 256 },
        "dealershipName": { "type": "string", "maxLength": 120 },
        "packId": { "type": "string", "maxLength": 100 },
        "packTitle": { "type": "string", "maxLength": 150 },
        "amountUSD": { "type": "number" },
        "rewardDetails": { "type": "string", "maxLength": 300 },
        "billingName": { "type": "string", "maxLength": 100 },
        "billingAddress": { "type": "string", "maxLength": 200 },
        "paymentMethodType": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["completed", "refunded"] },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "userId", "userName", "packId", "packTitle", "amountUSD", "status", "createdAt"]
    },
    "AuctionBid": {
      "title": "Live Auction Bid",
      "description": "Live auction bid placed by a player or AI rival",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "auctionId": { "type": "string", "maxLength": 128 },
        "bidderId": { "type": "string", "maxLength": 128 },
        "bidderName": { "type": "string", "maxLength": 100 },
        "dealershipName": { "type": "string", "maxLength": 120 },
        "bidAmount": { "type": "number" },
        "isAi": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "auctionId", "bidderId", "bidderName", "bidAmount", "createdAt"]
    },
    "AuctionVote": {
      "title": "Daily AI Rival Vote",
      "description": "Player vote on whether AI rivals participate in daily live auction",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "voterId": { "type": "string", "maxLength": 128 },
        "voterName": { "type": "string", "maxLength": 100 },
        "voteAllowAi": { "type": "boolean" },
        "day": { "type": "number" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "voterId", "voterName", "voteAllowAi", "day", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and online dealer status"
    },
    "/save_slots/{slotId}": {
      "schema": "SaveSlot",
      "description": "Cloud game save data for each slot"
    },
    "/b2b_offers/{offerId}": {
      "schema": "B2BOffer",
      "description": "Multiplayer B2B wholesale vehicle trade market"
    },
    "/chat_messages/{messageId}": {
      "schema": "LiveChat",
      "description": "Live global dealership chat messages"
    },
    "/purchases/{purchaseId}": {
      "schema": "Purchase",
      "description": "In-game purchase transaction records"
    },
    "/auction_bids/{bidId}": {
      "schema": "AuctionBid",
      "description": "Live multiplayer auction bids"
    },
    "/auction_votes/{voteId}": {
      "schema": "AuctionVote",
      "description": "Daily player votes for AI rival participation"
    }
  }
}
